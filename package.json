{
  "name": "tablixpos",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.tablixpos.desktop",
    "productName": "TablixPOS",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/tablixlogo.ico"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/tablixlogo.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "appimage"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "adewalemudasiru",
        "repo": "tablixpos",
        "releaseType": "draft"
      }
    ]
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "cross-env ELECTRON_DEV=true concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "npm run build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-react": "^3.45.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.3",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "qz-tray": "^2.2.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^7.18.1",
    "recharts": "^3.9.2",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.0.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.2",
    "cross-env": "^7.0.3",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8.1.5",
    "wait-on": "^9.0.0"
  }
}
